{
  "name": "@team6083/ui",
  "version": "0.1.1",
  "description": "The team's Chakra UI theme and the standard blocks every web app needs",
  "keywords": [
    "chakra-ui",
    "react",
    "design-system",
    "components",
    "theme"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team6083/ui.git"
  },
  "homepage": "https://github.com/Team6083/ui#readme",
  "bugs": {
    "url": "https://github.com/Team6083/ui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm run build",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
